# 飞书推送凭据（复制到 TC_HOME/.env 后填写）
# 进程环境变量优先于本文件。
# notify.enabled=false 时这些都可以留空，推送会写进 TC_HOME/logs/push_preview/。

# 方式一：群机器人 webhook（最简单，只能发不能收）
TC_FEISHU_WEBHOOK_URL=

# 方式二：企业自建应用（可发卡片，也是记账机器人长连接的前提）
TC_FEISHU_APP_ID=
TC_FEISHU_APP_SECRET=
TC_FEISHU_RECEIVE_ID_TYPE=chat_id
TC_FEISHU_RECEIVE_ID=

# 只接受这个 open_id 发来的记账消息，其他人发的一律忽略
TC_FEISHU_OWNER_OPEN_ID=
